@page "/"

<PageTitle>Home</PageTitle>
<NavigationLock ConfirmExternalNavigation="true"/>

<div id="canvas" tabindex="0" class="canvas"
     @onkeydown="HandleKeyPress"
     @onmousemove="OnCanvasMouseMove"
     @onmouseup="OnCanvasMouseUp">
    <div class="card">
        <h1>Taletidstageren <span class="version-number">(v4.0)</span></h1>
        <div class="card-box">
            <label style="text-align: center">Tilføj deltager:</label>
            <div id="name-input">
                <input
                    type="text"
                    @bind="ParticipantName"
                    @bind:event="oninput"
                    @onkeydown="OnEnterPress"/>
            </div>
            <div class="avatar-preset-row" role="group" aria-label="Avatar preset">
                <button type="button"
                        class="avatar-preset-button @(selectedPreset == AvatarPreset.Male ? "selected" : null)"
                        title="Male default"
                        @onclick="SelectMalePreset">
                    <AvatarView Config="defaultMaleAvatar" CssClass="avatar-preset-view"/>
                </button>
                <button type="button"
                        class="avatar-preset-button @(selectedPreset == AvatarPreset.Female ? "selected" : null)"
                        title="Female default"
                        @onclick="SelectFemalePreset">
                    <AvatarView Config="defaultFemaleAvatar" CssClass="avatar-preset-view"/>
                </button>
                @if (customAvatar is not null)
                {
                    <button type="button"
                            class="avatar-preset-button @(selectedPreset == AvatarPreset.Custom ? "selected" : null)"
                            title="Custom avatar"
                            @onclick="SelectCustomPreset">
                        <AvatarView Config="customAvatar" CssClass="avatar-preset-view"/>
                    </button>
                }
                <button type="button"
                        class="avatar-preset-button avatar-edit-button"
                        title="Customize avatar"
                        @onclick="OpenAvatarEditor">
                    <img src="images/svgs/edit.svg" alt="Customize avatar" class="avatar-edit-icon"/>
                </button>
            </div>
            <button @onclick="AddParticipant" class="add-button">Tilføj</button>
        </div>
    </div>
    <DisplayData Participants="ParticipantsService.participants"/>
    <ResetAllTimers Participants="ParticipantsService.participants"/>
    <ExportMeetingSetup />
    <ImportMeetingSetup OnImported="StateHasChanged" />
    @foreach (var participant in ParticipantsService.participants)
    {
        <ParticipantUI Participant="participant"
                       OnStartTiming="StopAllOthers"
                       OnDragStarted="OnCardDragStarted"
                       IsDragging="draggingParticipantId == participant.Id"/>
    }

    <AvatarEditorModal Visible="showAvatarEditor"
                       InitialConfig="selectedAvatar"
                       OnConfirm="OnAvatarConfirmed"
                       OnCancel="CloseAvatarEditor"/>
</div>
