@page "/"

<PageTitle>Home</PageTitle>
<NavigationLock ConfirmExternalNavigation="true"/>

<div id="canvas" tabindex="0" class="canvas" @onkeydown="HandleKeyPress">
    <div class="card">
        <h1>Taletidstageren <span class="version-number">(v4.0)</span></h1>
        <div class="card-box">
            <label style="text-align: center">Tilføj deltager:</label>
            <div id="name-input">
                <input
                    type="text"
                    @bind="ParticipantName"
                    @bind:event="oninput"
                    @onkeydown="OnEnterPress"/>
                <AvatarView Config="selectedAvatar"
                            CssClass="select-avatar-button"
                            @onclick="OpenAvatarEditor"
                            title="Customize avatar"/>
            </div>
            <button @onclick="AddParticipant" class="add-button">Tilføj</button>
        </div>
    </div>
    <DisplayData Participants="ParticipantsService.participants"/>
    <ResetAllTimers Participants="ParticipantsService.participants"/>
    <ExportMeetingSetup />
    <ImportMeetingSetup OnImported="StateHasChanged" />
    @foreach (var participant in ParticipantsService.participants)
    {
        <ParticipantUI Participant="participant" OnStartTiming="StopAllOthers"/>
    }

    <AvatarEditorModal Visible="showAvatarEditor"
                       InitialConfig="selectedAvatar"
                       OnConfirm="OnAvatarConfirmed"
                       OnCancel="CloseAvatarEditor"/>
</div>
